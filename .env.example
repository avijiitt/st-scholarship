# Copy this file to .env and configure your Supabase project parameters.
# NOTE: Only use anon / publishable keys for client code. Never use service_role key.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
